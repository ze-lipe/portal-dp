NODE_ENV=development
APP_NAME=portal-dp
APP_ENV=development
APP_VERSION=0.0.0-etp00
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
API_CORS_ENABLED=true
LOG_LEVEL=info
OTEL_SERVICE_NAME=portal-dp-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=

# Cada processo usa uma credencial propria. Nunca use o papel proprietario na API.
DATABASE_URL=postgresql://portal_dp_app_login:LOCAL_APP_CHANGE_ME@localhost:5432/portal_dp?options=-c%20role%3Dportal_dp_app
WORKER_DATABASE_URL=postgresql://portal_dp_worker_login:LOCAL_WORKER_CHANGE_ME@localhost:5432/portal_dp?options=-c%20role%3Dportal_dp_worker
MIGRATOR_DATABASE_URL=postgresql://portal_dp_bootstrap:LOCAL_ONLY_CHANGE_ME@localhost:5432/portal_dp
TEST_DATABASE_URL=postgresql://portal_dp_bootstrap:LOCAL_ONLY_CHANGE_ME@localhost:5432/portal_dp_test
APP_DATABASE_PASSWORD=LOCAL_APP_CHANGE_ME
WORKER_DATABASE_PASSWORD=LOCAL_WORKER_CHANGE_ME

# A prova sintetica so existe em desenvolvimento/teste e nasce desligada.
ETP00_SYNTHETIC_PROOF_ENABLED=false
PRIVATE_OBJECT_ROOT=./tmp/private-objects
WORKER_ID=portal-dp-worker-etp00-local
WORKER_ACTOR_ID=10000000-0000-4000-8000-000000000001
WORKER_COMPANY_IDS=00000000-0000-4000-8000-00000000000a,00000000-0000-4000-8000-00000000000b,00000000-0000-4000-8000-00000000000c
OUTBOX_DELAY_ALERT_MS=300000
