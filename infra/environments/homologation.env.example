APP_ENV=homologation
NODE_ENV=homologation
LOG_LEVEL=info
API_CORS_ENABLED=false
OTEL_SERVICE_NAME=portal-dp-homologation
ETP00_SYNTHETIC_PROOF_ENABLED=false

# Valores reais sao injetados pelo cofre do ambiente. Nunca copiar os de desenvolvimento.
DATABASE_URL=SECRET_MANAGER_REFERENCE
WORKER_DATABASE_URL=SECRET_MANAGER_REFERENCE
MIGRATOR_DATABASE_URL=SECRET_MANAGER_REFERENCE
PRIVATE_OBJECT_ROOT=PRIVATE_OBJECT_ADAPTER_REFERENCE
